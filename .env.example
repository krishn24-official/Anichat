# Copy to .env and fill in the keys.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDERS=gemini,groq

# Vector database. Unset = local folder data/qdrant (fine for one or two series, slow beyond ~10k chunks).
# Local server:  docker run -d --name anichat-qdrant --restart unless-stopped -p 6333:6333 -v "${PWD}\data\qdrant_server:/qdrant/storage" qdrant/qdrant:v1.19.2
# Qdrant Cloud:  set the cluster URL and QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chat questions per visitor (0 = no limit). TRUST_PROXY=1 only when deployed behind a hosting proxy.
CHAT_PER_MINUTE=10
CHAT_PER_DAY=200
TRUST_PROXY=0
